# ===== 记忆服务（PowerContext）=====
# PowerContext 的地址。本作品不在前端暴露它，全部由后端代读代写。
POWERCONTEXT_URL=http://127.0.0.1:8000
# 可选。当前本地实例允许匿名访问，留空即可；
# 若部署实例开启了鉴权，把 Bearer token 填进来。
POWERCONTEXT_TOKEN=

# ===== 记忆本身份 =====
# 一个项目 = 一个 PowerContext scope。idempotency_key 固定，重启/换浏览器都复用同一个 scope。
SCOPE_TITLE=组会搭子
SCOPE_SUMMARY=研究生组会周报记忆本：进展 / 承诺 / 卡点
IDEMPOTENCY_KEY=gm-groupmeeting-buddy

# ===== 模型（任何 OpenAI 兼容接口）=====
# 三项都留空也能跑通全流程，此时「生成组会汇报」自动降级为模板拼装，
# 页面顶部会明确标出这次是模板稿。
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_NAME=gpt-4o-mini

# ===== 本服务 =====
# 注意：不能用 8000，那个端口是 PowerContext 的。
PORT=8080
